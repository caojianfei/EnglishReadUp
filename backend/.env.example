# 复制为 backend/.env 后填写。.env 不进版本库。

# 数据目录（相对 backend/ 或绝对路径）
DATA_DIR=./data

# 抓取
FETCH_RATE_LIMIT=2.0
FETCH_TIMEOUT=25
RENDER_DOMAINS=sixthtone.com
RENDER_TIMEOUT_S=60
JOB_WORKERS=2

# LLM（M3 使用）：只剩「选段【解析】」一种任务走模型，划词查词已经改本地词典库。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=

# 本地词典库（划词的音标与释义都来自它们，红线 3）。
# 两个文件都不进版本库，**服务启动时会自检并自动补齐**（后台下载，不堵启动，
# 见 docs/USAGE.md §2.3）；scripts/fetch_dicts.py 是同一实现的手工入口。
#   ECDICT_DB     预编译 SQLite（约 811 MB）：中文释义 / 词性 / 考纲标签 / 词频
#   IPA_DICT_DIR  目录，里面放 ipa_en_us.txt 与 ipa_en_uk.txt（约 4.7 MB）：英美音标
# 留空即用 DATA_DIR 下的默认文件名。
ECDICT_DB=
IPA_DICT_DIR=

# 启动时自检并补齐缺失的词典数据（缺哪个下哪个，已有的不重下）。
# 关掉：离线环境、或想自己控制下载时机（关掉后划词会提示去跑 fetch_dicts.py）。
DICT_AUTODOWNLOAD=true

# 词典录音回退（仅当有道拿不到该词发音时才用得上）。
# 音标**不再**走这里 —— 它只是录音的备选源。
DICT_API_BASE=https://en.wiktionary.org/w/api.php

# 发音录音（M7 使用）：有道 dictvoice。type=1 英音、type=2 美音。
# 音频**不预热**：点喇叭才下载。但 audio_min_interval / audio_jitter 仍**不要调小** ——
# 连着点几个词时它们决定节拍，太密会被风控（见 docs/DESIGN.md §6.2）。
DICT_AUDIO_BASE=https://dict.youdao.com/dictvoice

# 默认口音（uk | us）。音标是英美双轨、词卡上两个喇叭并列；
# 这个值决定「主打哪个」：`/api/dict/{word}/audio` 不带 accent 参数时用它。
AUDIO_ACCENT=uk

# 前端产物托管：cd frontend && npm run build 之后，由后端同进程直发，
# 日常只起 8010 一个服务就够（见 docs/USAGE.md §4）。
SERVE_FRONTEND=true
# FRONTEND_DIST=../frontend/dist
